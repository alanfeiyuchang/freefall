    "NSHandsTrackingUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit du mit den Händen die Stange greifen, den Auslösegriff und die Steuerschlaufen ziehen und den Höhenmesser am Handgelenk tragen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you grab the bar, pull the deployment handle and toggles with your hands, and wear the altimeter on your wrist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para agarrar la barra, tirar de la anilla de apertura y de los mandos con las manos, y llevar el altímetro en la muñeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour saisir la barre, tirer la poignée d'ouverture et les commandes avec vos mains, et porter l'altimètre au poignet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per afferrare la barra, tirare la maniglia di apertura e i comandi con le mani, e indossare l'altimetro al polso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手でバーをつかみ、開傘ハンドルとトグルを引き、手首に高度計を着けるために使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손으로 손잡이를 잡고, 낙하산 핸들과 토글을 당기고, 손목에 고도계를 차기 위해 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para segurar a barra, puxar o punho de abertura e os batoques com as mãos, e usar o altímetro no pulso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用来让你用手抓扶杆、拉开伞拉手和操纵环，并把高度表戴在你的手腕上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來讓你用手抓扶桿、拉開傘拉手和操縱環，並把高度計戴在你的手腕上。"
          }
        }
      }
    },
    "NSWorldSensingUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Position und Ausrichtung deines Kopfes zu verfolgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks the position and direction of your head."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para seguir la posición y la orientación de tu cabeza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour suivre la position et l'orientation de votre tête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per tracciare la posizione e l'orientamento della testa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭の位置と向きを追跡するために使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머리의 위치와 방향을 추적하는 데 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para acompanhar a posição e a direção da sua cabeça."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用来跟踪你头部的位置和朝向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來追蹤你頭部的位置和朝向。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
