            "value": "Im Baum hängen geblieben – %lld m vom Landepunkt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hung up in the trees — %lld m from the landing spot"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los árboles: a %lld m del punto de aterrizaje"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les arbres — à %lld m du point d'atterrissage"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tra gli alberi: a %lld m dal punto di atterraggio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "林に落ちて木に引っかかった——着地点から %lld m"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숲에 떨어져 나무에 걸렸습니다 — 착지 지점에서 %lld m"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nas árvores — a %lld m do ponto de pouso"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "落进树林，挂在树上了——离降落点 %lld 米"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "落進樹林，掛在樹上了——離降落點 %lld 公尺"
