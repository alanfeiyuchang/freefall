    "还没到开伞高度\n等手表报警再拉": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu hoch zum Öffnen\nWarte auf den Alarm der Uhr"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too high to deploy\nWait for the watch alarm"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún es pronto para abrir\nEspera la alarma del reloj"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop haut pour ouvrir\nAttendez l'alarme de la montre"
          }
        },
        "it": {
