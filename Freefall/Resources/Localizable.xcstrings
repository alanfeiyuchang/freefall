    "转头、转身来转向，伞跟着你转；捏住往下拉减速": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopf und Körper drehen zum Steuern, der Schirm folgt; zusammendrücken und nach unten ziehen zum Bremsen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your head and body to steer, the canopy follows; pinch and pull down to slow down"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la cabeza y el cuerpo para dirigir, la vela te sigue; pellizca y tira hacia abajo para frenar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tournez la tête et le corps pour diriger, la voile suit ; pincez et tirez vers le bas pour freiner"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira testa e corpo per dirigere, la vela ti segue; pizzica e tira giù per frenare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭と体の向きで旋回、キャノピーがついてくる。ピンチして下に引くと減速"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머리와 몸을 돌려 방향 전환, 캐노피가 따라옵니다. 핀치한 채 아래로 당기면 감속"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire a cabeça e o corpo para dirigir, o velame acompanha; faça a pinça e puxe para baixo para frear"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转头、转身来转向，伞跟着你转；捏住往下拉减速"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉頭、轉身來轉向，傘跟著你轉；捏住往下拉減速"
          }
        }
      }
    },
    "转头、转身来转向，伞跟着你转；操纵环一起拉减速，两手往前推俯冲": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopf und Körper drehen zum Steuern, der Schirm folgt; beide Schlaufen ziehen zum Bremsen, Hände nach vorn zum Sturzflug"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your head and body to steer, the canopy follows; pull both toggles to slow down, push both hands forward to dive"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la cabeza y el cuerpo para dirigir, la vela te sigue; tira de ambos mandos para frenar, empuja las manos hacia delante para picar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tournez la tête et le corps pour diriger, la voile suit ; tirez les deux commandes pour freiner, poussez les mains en avant pour piquer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira testa e corpo per dirigere, la vela ti segue; tira entrambi i comandi per frenare, spingi le mani avanti per picchiare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭と体の向きで旋回、キャノピーがついてくる。トグルを両方引いて減速、両手を前に押して急降下"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머리와 몸을 돌려 방향 전환, 캐노피가 따라옵니다. 토글을 함께 당겨 감속, 두 손을 앞으로 밀어 급강하"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire a cabeça e o corpo para dirigir, o velame acompanha; puxe os dois batoques para frear, empurre as mãos para a frente para mergulhar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转头、转身来转向，伞跟着你转；操纵环一起拉减速，两手往前推俯冲"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉頭、轉身來轉向，傘跟著你轉；操縱環一起拉減速，兩手往前推俯衝"
          }
        }
      }
    },
