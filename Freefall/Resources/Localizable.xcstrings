    "落进降落点解锁": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Landepunkt landen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Land on the spot to unlock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterriza en el punto para desbloquear"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atterrissez sur le point pour débloquer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Atterra sul punto per sbloccare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着地点に降りると解除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "착지 지점에 내리면 해제"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouse no ponto para desbloquear"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "落进降落点解锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "落進降落點解鎖"
          }
        }
      }
    },
    "落进降落点，解锁那一关的降落伞；落进正中的黄色靶心，再解锁那一关的手套和袖子。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lande auf dem Landepunkt eines Levels, um seinen Schirm freizuschalten – im gelben Zentrum auch seine Handschuhe & Ärmel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Land on a level's landing spot to unlock its canopy; land in the yellow bullseye at the center to unlock its gloves and sleeves too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterriza en el punto de aterrizaje de un nivel para desbloquear su vela; en la diana amarilla del centro, también sus guantes y mangas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atterrissez sur le point d'atterrissage d'un niveau pour débloquer sa voile ; dans le centre jaune, ses gants et manches aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Atterra sul punto di atterraggio di un livello per sbloccarne la vela; nel centro giallo, anche guanti e maniche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着地点に降りるとそのステージのキャノピーが、中央の黄色い中心に降りるとグローブと袖も解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "착지 지점에 내리면 그 스테이지의 캐노피가, 가운데 노란 정중앙에 내리면 장갑과 소매도 해제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouse no ponto de pouso de uma fase para desbloquear o velame; no centro amarelo, também as luvas e mangas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "落进降落点，解锁那一关的降落伞；落进正中的黄色靶心，再解锁那一关的手套和袖子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "落進降落點，解鎖那一關的降落傘；落進正中的黃色靶心，再解鎖那一關的手套和袖子。"
          }
        }
      }
    },
