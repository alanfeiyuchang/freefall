    "捏住往下拉：左手左转，右手右转": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammendrücken und nach unten ziehen: links dreht links, rechts dreht rechts"
          }
        },
        "en": {
          "stringUnit": {
