        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "破火山口 · 躲開熔岩和毒煙"
          }
        }
      }
    },
    "破火山口里一座正在喷的火山锥：别靠近火山口和烟柱，别踩到熔岩": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ausbrechender Kegel in einer Caldera: Halte Abstand zum Krater und zur Rauchsäule und tritt nicht in die Lava"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An erupting cone inside a caldera: stay clear of the crater and the plume, and don't step in the lava"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cono en erupción dentro de una caldera: no te acerques al cráter ni a la columna de humo, y no pises la lava"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cône en éruption au fond d'une caldeira : restez loin du cratère et du panache, et ne marchez pas dans la lave"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cono in eruzione dentro una caldera: stai lontano dal cratere e dal pennacchio, e non pestare la lava"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カルデラの中で噴火中の火山。火口と噴煙に近づかず、溶岩を踏まないように"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "칼데라 안에서 분화 중인 화산. 분화구와 연기 기둥에 다가가지 말고 용암을 밟지 마세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cone em erupção dentro de uma caldeira: fique longe da cratera e da coluna de fumaça, e não pise na lava"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "破火山口里一座正在喷的火山锥：别靠近火山口和烟柱，别踩到熔岩"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "破火山口裡一座正在噴發的火山錐：別靠近火山口和煙柱，別踩到熔岩"
          }
        }
      }
    },
