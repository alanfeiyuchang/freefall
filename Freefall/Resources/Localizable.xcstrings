    "高度还多：两手往前推俯冲，或者先飞过降落点再掉头": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch viel Höhe: nach vorn schieben zum Sturzflug oder über den Landepunkt hinaus und umkehren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plenty of height: push forward to dive, or fly past the landing spot and turn back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te sobra altura: empuja para picar o pasa el punto de aterrizaje y da la vuelta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encore de la hauteur : poussez pour piquer, ou dépassez le point d'atterrissage et faites demi-tour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora molta quota: spingi per picchiare o supera il punto di atterraggio e torna indietro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高度に余裕あり：両手を前に押して急降下するか、着地点を通り過ぎてから引き返す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고도가 넉넉합니다: 두 손을 앞으로 밀어 급강하하거나, 착지 지점을 지나쳤다가 돌아오세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda tem altura: empurre para mergulhar ou passe do ponto de pouso e volte"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高度还多：两手往前推俯冲，或者先飞过降落点再掉头"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高度還多：兩手往前推俯衝，或者先飛過降落點再掉頭"
          }
        }
      }
    },
