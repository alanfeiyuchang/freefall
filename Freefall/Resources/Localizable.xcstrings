    "伸出右手，握住右边的黄色扶杆": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Greif mit der rechten Hand nach der gelben Stange"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach out with your right hand and grab the yellow bar"
